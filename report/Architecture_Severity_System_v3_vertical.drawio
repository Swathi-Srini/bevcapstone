;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="240" width="170" height="80" as="geometry"/></mxCell><mxCell id="rf" value="&lt;b&gt;Fog regressor&lt;/b&gt;&lt;br&gt;ridge, level ∈ [0, 1]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="205" y="240" width="170" height="80" as="geometry"/></mxCell><mxCell id="rr" value="&lt;b&gt;Rain regressor&lt;/b&gt;&lt;br&gt;ridge, level ∈ [0, 1]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="390" y="240" width="170" height="80" as="geometry"/></mxCell><mxCell id="ema1" value="&lt;b&gt;Temporal filter 1&lt;/b&gt;: EMA of kind probabilities (α = 0.15) → hard kind = argmax" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="500" height="44" as="geometry"/></mxCell><mxCell id="sel" value="&lt;b&gt;Level of the selected kind&lt;/b&gt; (clear → 0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="436" width="500" height="40" as="geometry"/></mxCell><mxCell id="ema2" value="&lt;b&gt;Temporal filter 2&lt;/b&gt;: EMA of level (α = 0.15)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="508" width="500" height="40" as="geometry"/></mxCell><mxCell id="cau" value="&lt;b&gt;Caution ĉ&lt;/b&gt; = filtered level (identity map: clear 0, fog = level, rain = level)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="500" height="44" as="geometry"/></mxCell><mxCell id="pol" value="→ caution branch of the policy (FC 1→16)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="140" y="662" width="300" height="40" as="geometry"/></mxCell><mxCell id="n" value="Fitted on 25,408 frames; evaluated on held-out routes (seeds 9040–9042). Probe levels fog 0.45 / 0.6 and rain 0.3 / 0.45 were never fitted." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1"><mxGeometry x="20" y="730" width="540" height="50" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="f" target="ft"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="ft" target="k"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="ft" target="rf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="ft" target="rr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="k" target="ema1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="ema1" target="sel"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell