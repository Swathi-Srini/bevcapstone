yle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="bev" target="cnn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="sc" target="mlp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="ch" target="cb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="cnn" target="fus"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="mlp" target="fus"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="fus" target="head"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="head" target="act"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="cb" target="fus"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="5 Training by DAgger (expansion)" id="90857226"><mxGraphModel dx="900" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="580" pageHeight="620" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="&lt;b&gt;Training only: camera-pipeline DAgger.&lt;/b&gt; Not part of the deployed system." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="540" height="30" as="geometry"/></mxCell><mxCell id="run" value="&lt;b&gt;Student drives&lt;/b&gt; through the full camera pipeline&lt;br&gt;(β = 1, then 0.5^t mixing with teacher; action noise 0.1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="60" y="50" width="460" height="60" as="geometry"/></mxCell><mxCell id="st" value="&lt;b&gt;States visited&lt;/b&gt; (weather mix clear / fog / rain; true c known in training)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#82b366;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="460" height="44" as="geometry"/></mxCell><mxCell id="tch" value="&lt;b&gt;Privileged teacher&lt;/b&gt; (reads exact simulator state)&lt;br&gt;IDM + SafeTeacher + curve guard 4.0&lt;br&gt;target speed 30(1 − c/3) km/h · following gap 10 + 15c m" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="60" y="234" width="460" height="80" as="geometry"/></mxCell><mxCell id="lab" value="&lt;b&gt;Action labels&lt;/b&gt; for the visited states → aggregate all rounds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#82b366;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="60" y="354" width="460" height="44" as="geometry"/></mxCell><mxCell id="fit" value="&lt;b&gt;Retrain student&lt;/b&gt; (Adam 1e-3, batch 128): 4 rounds × 12 episodes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#82b366;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="60" y="438" width="460" height="44" as="geometry"/></mxCell><mxCell id="B" value="&lt;b&gt;Model B&lt;/b&gt; = trained network with true c (reference)&lt;br&gt;&lt;b&gt;Model C&lt;/b&gt; = the same network run with the image-based ĉ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="522" width="460" height="60" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;dashed=1;" edge="1" parent="1" source="run" target="st"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;dashed=1;" edge="1" parent="1" source="st" target="tch"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;strokeColor=#d79b00;strokeWidth=2;dashed=1;" edge="1" parent="1" source="tch" target="lab"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;dashed=1;" edge="1" parent="1" source="lab" target="fit"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;dashed=1;" edge="1" parent="1" source="fit" target="B"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="next round" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;dashed=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="fit" target="run"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="545" y="460"/><mxPoint x="545" y="80"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>