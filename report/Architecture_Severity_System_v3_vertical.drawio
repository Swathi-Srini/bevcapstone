<mxfile host="app.diagrams.net"><diagram name="1 Overall system (Fig. 1)" id="97071777"><mxGraphModel dx="900" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="660" pageHeight="1350" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="&lt;b&gt;Overall system.&lt;/b&gt; Orange = new in this work. Dashed orange = training only; dashed grey = environment feedback loop. Model A = the same network without the orange caution path." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="6" width="620" height="34" as="geometry"/></mxCell><mxCell id="c_sens" value="&lt;b&gt;Sensor Layer&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="48" width="600" height="104" as="geometry"/></mxCell><mxCell id="c1" value="Front-right RGB camera&lt;br&gt;1200×900, 60° FOV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="30" y="84" width="110" height="56" as="geometry"/></mxCell><mxCell id="c2" value="Front-left RGB camera&lt;br&gt;1200×900, 60° FOV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="148" y="84" width="110" height="56" as="geometry"/></mxCell><mxCell id="c3" value="Left RGB camera&lt;br&gt;1200×900, 60° FOV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="266" y="84" width="110" height="56" as="geometry"/></mxCell><mxCell id="c4" value="Right RGB camera&lt;br&gt;1200×900, 60° FOV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="384" y="84" width="110" height="56" as="geometry"/></mxCell><mxCell id="c5" value="Rear RGB camera&lt;br&gt;1200×900, 60° FOV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="502" y="84" width="110" height="56" as="geometry"/></mxCell><mxCell id="wx" value="&lt;b&gt;Controlled weather intervention&lt;/b&gt;&lt;br&gt;synthetic fog / rain image corruption on all camera inputs&lt;br&gt;visual degradation only: no friction / dynamics change" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="190" width="420" height="66" as="geometry"/></mxCell><mxCell id="c_perc" value="&lt;b&gt;Perception Modules&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="290" width="390" height="262" as="geometry"/></mxCell><mxCell id="sgm" value="Stereo SGM  Z = f·B / d_px&lt;br&gt;depth map H×W" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="326" width="350" height="50" as="geometry"/></mxCell><mxCell id="yf" value="YOLOv8 front: detections (bboxes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="388" width="350" height="40" as="geometry"/></mxCell><mxCell id="ylr" value="YOLOv8 left and right: detections (bboxes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="350" height="40" as="geometry"/></mxCell><mxCell id="yr" value="YOLOv8 rear: detections (bboxes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="492" width="350" height="40" as="geometry"/></mxCell><mxCell id="est" value="&lt;b&gt;Severity estimator (NEW)&lt;/b&gt;&lt;br&gt;image-based&lt;br&gt;front-left weather-degraded frame&lt;br&gt;→ 7 image features&lt;br&gt;→ kind classifier + fog / rain level regressors&lt;br&gt;→ EMA filter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="440" y="290" width="180" height="150" as="geometry"/></mxCell><mxCell id="caut" value="&lt;b&gt;Caution ĉ ∈ [0, 1]&lt;/b&gt;&lt;br&gt;clear 0, fog = level, rain = level&lt;br&gt;(no weather label given to the policy)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="440" y="480" width="180" height="72" as="geometry"/></mxCell><mxCell id="hd" value="&lt;b&gt;HD map&lt;/b&gt;&lt;br&gt;route waypoints&lt;br&gt;lane boundaries" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="592" width="150" height="62" as="geometry"/></mxCell><mxCell id="bev" value="&lt;b&gt;BEV grid builder&lt;/b&gt;&lt;br&gt;64×64 float32&lt;br&gt;0 free · 0.5 centreline · 0.8 boundary · 1.0 obstacle&lt;br&gt;ego at row 56, column 32" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="190" y="584" width="220" height="110" as="geometry"/></mxCell><mxCell id="sc" value="&lt;b&gt;Scalar state (6D)&lt;/b&gt;&lt;br&gt;[v, s, d, θ_err, κ_ahead, d_goal]&lt;br&gt;HD map + GPS + IMU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="20" y="682" width="150" height="78" as="geometry"/></mxCell><mxCell id="c_pol" value="&lt;b&gt;Policy network (one network)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="780" width="600" height="232" as="geometry"/></mxCell><mxCell id="mlp" value="&lt;b&gt;MLP branch (scalar)&lt;/b&gt;&lt;br&gt;FC 6→64→32&lt;br&gt;32D" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="180" height="70" as="geometry"/></mxCell><mxCell id="cnn" value="&lt;b&gt;CNN branch (BEV)&lt;/b&gt;&lt;br&gt;Conv 5×5 → 3×3 → 3×3&lt;br&gt;→ pooling → FC → 128D" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="240" y="820" width="160" height="70" as="geometry"/></mxCell><mxCell id="cb" value="&lt;b&gt;Caution branch (NEW)&lt;/b&gt;&lt;br&gt;FC 1→16 + ReLU&lt;br&gt;16D" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="420" y="820" width="180" height="70" as="geometry"/></mxCell><mxCell id="fus" value="&lt;b&gt;Fusion concatenation&lt;/b&gt; [128, 32, 16] = 176D&lt;br&gt;(Model A: [128, 32] = 160D)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="920" width="330" height="62" as="geometry"/></mxCell><mxCell id="head" value="&lt;b&gt;Action head&lt;/b&gt;&lt;br&gt;FC 176→128→2, ReLU + tanh" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="920" width="210" height="62" as="geometry"/></mxCell><mxCell id="act" value="&lt;b&gt;Action output (2D)&lt;/b&gt;: [steering, longitudinal] ∈ [−1, 1]&lt;br&gt;positive: throttle, negative: brake" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="130" y="1050" width="400" height="56" as="geometry"/></mxCell><mxCell id="env" value="&lt;b&gt;MetaDrive environment&lt;/b&gt;: next state s(t+1)&lt;br&gt;energy and outcome logging" style="rounded=1;whiteSpac