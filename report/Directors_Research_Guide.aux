\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {Before and after reinforcement learning, for each of the four attempts.} Each panel compares the model before reinforcement learning with the model after it, using the best available measurement for that attempt: 70 test episodes (attempt 1), 40 validation episodes (attempts 2 and 3) and 200 test episodes per weather condition (attempt 4).}}{14}{figure.caption.17}\protected@file@percent }
\newlabel{fig:rlbeforeafter}{{7}{14}{\textbf {Before and after reinforcement learning, for each of the four attempts.} Each panel compares the model before reinforcement learning with the model after it, using the best available measurement for that attempt: 70 test episodes (attempt 1), 40 validation episodes (attempts 2 and 3) and 200 test episodes per weather condition (attempt 4)}{figure.caption.17}{}}
