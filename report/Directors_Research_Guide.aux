\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {Gap to the other vehicle as drawn in the model's input, in the last steps before two collisions.} For two crashes of a bird's-eye-view model, the true distance between the car and the nearest vehicle (black) is compared with the distance that the 64 by 64 grid shows (red). A hollow circle marks steps at which the vehicle is not in the grid at all. These numbers are copied from the diagnosis note of 10 November (two replayed episodes).}}{15}{figure.caption.18}\protected@file@percent }
\newlabel{fig:fidelity}{{8}{15}{\textbf {Gap to the other vehicle as drawn in the model's input, in the last steps before two collisions.} For two crashes of a bird's-eye-view model, the true distance between the car and the nearest vehicle (black) is compared with the distance that the 64 by 64 grid shows (red). A hollow circle marks steps at which the vehicle is not in the grid at all. These numbers are copied from the diagnosis note of 10 November (two replayed episodes)}{figure.caption.18}{}}
