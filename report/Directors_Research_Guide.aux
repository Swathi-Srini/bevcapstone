\@writefile{toc}{\contentsline {subsection}{\numberline {5.1}The main result: 200 drives in clear weather}{6}{subsection.5.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Success rate of the driving models on the same 200 test episodes.} Each bar is the share of 200 identical test episodes (scenario seeds 5000 to 5199, clear weather, sparse traffic) in which a model reached the destination without a collision and without leaving the road. The black line is the 95\% Wilson confidence interval, the range of success rates that is statistically compatible with the observed count. Grey bars are rule-based teachers that see the exact simulator state; orange bars are the two baseline models supplied by the teammates; blue bars are models trained in this project.}}{7}{figure.caption.4}\protected@file@percent }
\newlabel{fig:headline}{{2}{7}{\textbf {Success rate of the driving models on the same 200 test episodes.} Each bar is the share of 200 identical test episodes (scenario seeds 5000 to 5199, clear weather, sparse traffic) in which a model reached the destination without a collision and without leaving the road. The black line is the 95\% Wilson confidence interval, the range of success rates that is statistically compatible with the observed count. Grey bars are rule-based teachers that see the exact simulator state; orange bars are the two baseline models supplied by the teammates; blue bars are models trained in this project}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Paired difference in success between the proposed model and each other model.} For each comparison the difference (proposed model minus the other model) is computed on the same 200 episodes. The point is the difference; the black line is the 95\% bootstrap interval obtained by resampling episodes 5000 times. A line entirely to the right of the zero line means the proposed model is better with statistical support.}}{8}{figure.caption.5}\protected@file@percent }
\newlabel{fig:paired}{{3}{8}{\textbf {Paired difference in success between the proposed model and each other model.} For each comparison the difference (proposed model minus the other model) is computed on the same 200 episodes. The point is the difference; the black line is the 95\% bootstrap interval obtained by resampling episodes 5000 times. A line entirely to the right of the zero line means the proposed model is better with statistical support}{figure.caption.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}The image-only driver}{8}{subsection.5.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}Does weather make driving worse?}{9}{subsection.5.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Measured effect of simulated fog and rain on the camera perception.} Left: the share of vehicles in view that the YOLO object detector finds, per weather condition (vertical lines are 95\% intervals). Right: the share of vehicle pixels at which the stereo-depth algorithm returns a valid distance. Weather conditions are the teammates' image augmentation at the intensity shown (0 = none, 1 = strongest). 40 scenes; 72 vehicle observations in clear weather and 144 in each weather condition.}}{9}{figure.caption.6}\protected@file@percent }
\newlabel{fig:perception}{{4}{9}{\textbf {Measured effect of simulated fog and rain on the camera perception.} Left: the share of vehicles in view that the YOLO object detector finds, per weather condition (vertical lines are 95\% intervals). Right: the share of vehicle pixels at which the stereo-depth algorithm returns a valid distance. Weather conditions are the teammates' image augmentation at the intensity shown (0 = none, 1 = strongest). 40 scenes; 72 vehicle observations in clear weather and 144 in each weather condition}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Success rate in four weather conditions under the measured perception degradation.} Four models were each evaluated on the same 200 episodes in clear weather, fog of intensity 1.0, rain of intensity 0.6 and rain of intensity 1.0. In every weather condition the input of the model was degraded as measured: vehicles can disappear from the bird's-eye-view grid, or be placed at a wrong distance. Black lines are 95\% intervals.}}{10}{figure.caption.7}\protected@file@percent }
\newlabel{fig:weather}{{5}{10}{\textbf {Success rate in four weather conditions under the measured perception degradation.} Four models were each evaluated on the same 200 episodes in clear weather, fog of intensity 1.0, rain of intensity 0.6 and rain of intensity 1.0. In every weather condition the input of the model was degraded as measured: vehicles can disappear from the bird's-eye-view grid, or be placed at a wrong distance. Black lines are 95\% intervals}{figure.caption.7}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.4}Caution-aware driver against the proposed driver, 200 drives in each weather}{10}{subsection.5.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.5}Three side studies}{11}{subsection.5.5}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Caution when perception is unreliable (40 drives, pilot).}{11}{section*.8}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Which input matters (10 drives, pilot).}{11}{section*.9}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Training with position error, and adding a second lane cue.} The proposed model reads the road from a map drawn into its input, so it needs to know where the car is on the map. Here the position estimate is shifted by a constant lateral distance (horizontal axis, metres; a small heading error grows with it). Success over 40 episodes for the proposed model and four models trained with random position errors; bands are 95\% intervals. Dashed lines: the map is the only source of lane position. Solid green and pink lines: a second, independent and noisy lane measurement (lateral offset and heading) is also given to the model. 40 episodes per point.}}{11}{figure.caption.11}\protected@file@percent }
\newlabel{fig:posetrained}{{6}{11}{\textbf {Training with position error, and adding a second lane cue.} The proposed model reads the road from a map drawn into its input, so it needs to know where the car is on the map. Here the position estimate is shifted by a constant lateral distance (horizontal axis, metres; a small heading error grows with it). Success over 40 episodes for the proposed model and four models trained with random position errors; bands are 95\% intervals. Dashed lines: the map is the only source of lane position. Solid green and pink lines: a second, independent and noisy lane measurement (lateral offset and heading) is also given to the model. 40 episodes per point}{figure.caption.11}{}}
\@writefile{toc}{\contentsline {paragraph}{A wrong position estimate (40 drives, pilot).}{11}{figure.caption.11}\protected@file@percent }
