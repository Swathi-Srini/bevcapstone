\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces \textbf  {Which test episodes each model fails.} Each thin column is one of the 200 test episodes; each row is one model. Green means the model succeeded in that episode, red means it failed. The episodes are sorted so that those failed by no model are on the left and those failed by many models are on the right.}}{37}{figure.caption.25}\protected@file@percent }
\newlabel{fig:strips}{{10}{37}{\textbf {Which test episodes each model fails.} Each thin column is one of the 200 test episodes; each row is one model. Green means the model succeeded in that episode, red means it failed. The episodes are sorted so that those failed by no model are on the left and those failed by many models are on the right}{figure.caption.25}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces \textbf  {Mean driving speed and estimated energy use of each model.} Each point is one model, placed by its mean speed (horizontal, metres per second) and its estimated traction energy per kilometre (vertical, watt-hours per kilometre) over the 200 clear-weather test episodes. The energy value is the mechanical work at the wheels of a declared virtual vehicle (no regenerative braking), not a battery measurement.}}{38}{figure.caption.26}\protected@file@percent }
\newlabel{fig:energy}{{11}{38}{\textbf {Mean driving speed and estimated energy use of each model.} Each point is one model, placed by its mean speed (horizontal, metres per second) and its estimated traction energy per kilometre (vertical, watt-hours per kilometre) over the 200 clear-weather test episodes. The energy value is the mechanical work at the wheels of a declared virtual vehicle (no regenerative braking), not a battery measurement}{figure.caption.26}{}}
