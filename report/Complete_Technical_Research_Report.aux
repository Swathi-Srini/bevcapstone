\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Measured effect of simulated fog and rain on the camera perception.} Left: the share of vehicles in view that the YOLO object detector finds, per weather condition (vertical lines are 95\% intervals). Right: the share of vehicle pixels at which the stereo-depth algorithm returns a valid distance. Weather conditions are the teammates' image augmentation at the intensity shown (0 = none, 1 = strongest). 40 scenes; 72 vehicle observations in clear weather and 144 in each weather condition.}}{21}{figure.caption.10}\protected@file@percent }
\newlabel{fig:perception}{{2}{21}{\textbf {Measured effect of simulated fog and rain on the camera perception.} Left: the share of vehicles in view that the YOLO object detector finds, per weather condition (vertical lines are 95\% intervals). Right: the share of vehicle pixels at which the stereo-depth algorithm returns a valid distance. Weather conditions are the teammates' image augmentation at the intensity shown (0 = none, 1 = strongest). 40 scenes; 72 vehicle observations in clear weather and 144 in each weather condition}{figure.caption.10}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.4}How detector retention was measured at different intensities, and how the driving model receives it}{22}{subsection.6.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Detector retention measured at different fog and rain intensities, and the probability that the driving model keeps a vehicle.} In 20 scenes (seeds 1000 to 1019, traffic density 0.3, stationary car, up to three vehicles placed around it) the same camera frames were passed through the teammates' vehicle detector twice: once clean and once with the weather filter at each intensity (two random weather draws per scene). Retention is the number of vehicles found with weather divided by the number found without weather. Grey dots are single scenes, the blue line is the mean over scenes with its 95\% interval, the orange dashed line is the measured retention capped at 1, which is the probability that the weather proxy keeps a vehicle in the driving model's grid. Dotted vertical lines mark the intensities used in the 200-episode weather tests.}}{23}{figure.caption.11}\protected@file@percent }
\newlabel{fig:detectorretention}{{3}{23}{\textbf {Detector retention measured at different fog and rain intensities, and the probability that the driving model keeps a vehicle.} In 20 scenes (seeds 1000 to 1019, traffic density 0.3, stationary car, up to three vehicles placed around it) the same camera frames were passed through the teammates' vehicle detector twice: once clean and once with the weather filter at each intensity (two random weather draws per scene). Retention is the number of vehicles found with weather divided by the number found without weather. Grey dots are single scenes, the blue line is the mean over scenes with its 95\% interval, the orange dashed line is the measured retention capped at 1, which is the probability that the weather proxy keeps a vehicle in the driving model's grid. Dotted vertical lines mark the intensities used in the 200-episode weather tests}{figure.caption.11}{}}
