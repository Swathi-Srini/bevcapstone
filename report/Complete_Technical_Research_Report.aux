\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {Success rate of the driving models on the same 200 test episodes.} Each bar is the share of 200 identical test episodes (scenario seeds 5000 to 5199, clear weather, sparse traffic) in which a model reached the destination without a collision and without leaving the road. The black line is the 95\% Wilson confidence interval, the range of success rates that is statistically compatible with the observed count. Grey bars are rule-based teachers that see the exact simulator state; orange bars are the two baseline models supplied by the teammates; blue bars are models trained in this project.}}{34}{figure.caption.20}\protected@file@percent }
\newlabel{fig:headline}{{7}{34}{\textbf {Success rate of the driving models on the same 200 test episodes.} Each bar is the share of 200 identical test episodes (scenario seeds 5000 to 5199, clear weather, sparse traffic) in which a model reached the destination without a collision and without leaving the road. The black line is the 95\% Wilson confidence interval, the range of success rates that is statistically compatible with the observed count. Grey bars are rule-based teachers that see the exact simulator state; orange bars are the two baseline models supplied by the teammates; blue bars are models trained in this project}{figure.caption.20}{}}
