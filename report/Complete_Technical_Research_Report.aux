\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {How the 200 test episodes end, for each model.} For every model, the 200 episodes are split into the four possible outcomes: success (green), collision (red), left the road (yellow) and timeout (grey). Each bar sums to one.}}{36}{figure.caption.22}\protected@file@percent }
\newlabel{fig:outcomes}{{8}{36}{\textbf {How the 200 test episodes end, for each model.} For every model, the 200 episodes are split into the four possible outcomes: success (green), collision (red), left the road (yellow) and timeout (grey). Each bar sums to one}{figure.caption.22}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces \textbf  {Paired difference in success between the proposed model and each other model.} For each comparison the difference (proposed model minus the other model) is computed on the same 200 episodes. The point is the difference; the black line is the 95\% bootstrap interval obtained by resampling episodes 5000 times. A line entirely to the right of the zero line means the proposed model is better with statistical support.}}{36}{figure.caption.23}\protected@file@percent }
\newlabel{fig:paired}{{9}{36}{\textbf {Paired difference in success between the proposed model and each other model.} For each comparison the difference (proposed model minus the other model) is computed on the same 200 episodes. The point is the difference; the black line is the 95\% bootstrap interval obtained by resampling episodes 5000 times. A line entirely to the right of the zero line means the proposed model is better with statistical support}{figure.caption.23}{}}
\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces Paired comparison of the proposed model with each other model. ``Only proposed model'' counts the seeds on which the proposed model succeeded and the other model did not; the exact McNemar test uses only these discordant seeds.}}{37}{table.caption.24}\protected@file@percent }
