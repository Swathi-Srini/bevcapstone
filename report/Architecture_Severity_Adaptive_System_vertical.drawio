<mxfile host="app.diagrams.net" agent="Claude Code" version="24.0.0">
  <diagram id="sev-arch" name="Overall system architecture (vertical)">
    <mxGraphModel dx="900" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="540" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- 1 simulator -->
        <mxCell id="sim" value="&lt;b&gt;MetaDrive simulator&lt;/b&gt;&lt;br&gt;map, traffic density 0.05, ego vehicle (10 Hz)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="90" y="20" width="360" height="46" as="geometry"/>
        </mxCell>
        <!-- 2 weather -->
        <mxCell id="wx" value="&lt;b&gt;Synthetic weather intervention&lt;/b&gt;&lt;br&gt;kind &lt;i&gt;k&lt;/i&gt; ∈ {clear, fog, rain}, level ℓ ∈ [0, 1]&lt;br&gt;applied to every camera image (shared stereo noise)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="90" y="96" width="360" height="56" as="geometry"/>
        </mxCell>
        <!-- 3 cameras -->
        <mxCell id="cam" value="&lt;b&gt;Five RGB cameras&lt;/b&gt; (1200×900, 60° FOV)&lt;br&gt;front-left / front-right stereo pair, left, right, rear" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="90" y="182" width="360" height="46" as="geometry"/>
        </mxCell>

        <!-- left column: perception -->
        <mxCell id="lhead" value="&lt;b&gt;Driving perception&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="248" width="230" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="det" value="Stereo SGM depth (front pair)&lt;br&gt;+ YOLOv8n on 4 views&lt;br&gt;→ object footprints" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="272" width="230" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="bev" value="Frozen BEV builder&lt;br&gt;+ HD-map layers&lt;br&gt;→ 64×64 BEV grid" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="358" width="230" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="scal" value="Ego scalar state (6)&lt;br&gt;(no simulator position given&lt;br&gt;to the student)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="444" width="230" height="56" as="geometry"/>
        </mxCell>

        <!-- right column: severity estimation -->
        <mxCell id="rhead" value="&lt;b&gt;Image-based severity estimation&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="280" y="248" width="240" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="frm" value="Front-left frame&lt;br&gt;(weather-processed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="280" y="272" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="feat" value="7 image features&lt;br&gt;Laplacian variance, gradient, contrast, dark channel, brightness, saturation, edge share" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="280" y="332" width="240" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="est" value="Kind classifier (clear / fog / rain)&lt;br&gt;+ separate fog and rain&lt;br&gt;intensity regressors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="280" y="416" width="240" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="ema" value="Temporal filter (EMA, α = 0.15)&lt;br&gt;identity caution: clear → 0,&lt;br&gt;fog → level, rain → level&lt;br&gt;&lt;b&gt;ĉ ∈ [0, 1]&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="280" y="492" width="240" height="70" as="geometry"/>
        </mxCell>

        <!-- policy -->
        <mxCell id="pol" value="&lt;b&gt;Adaptive driving policy&lt;/b&gt; (one network)&lt;br&gt;CNN(BEV)  |  MLP(scalars)  |  FC(1→16)(ĉ)&lt;br&gt;concatenate → 176-D fusion → 128 → action head&lt;br&gt;&lt;i&gt;Model A: same network, no caution branch&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="602" width="420" height="82" as="geometry"/>
        </mxCell>
        <mxCell id="act" value="Action: [steering, throttle / brake] → MetaDrive step" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="90" y="714" width="360" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="eng" value="&lt;b&gt;Energy and outcome measurement&lt;/b&gt;&lt;br&gt;traction work per step (inertial + aerodynamic + rolling, no regeneration) → Wh/km&lt;br&gt;success / collision / off-road / timeout, speed, braking" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="780" width="420" height="62" as="geometry"/>
        </mxCell>

        <!-- training only -->
        <mxCell id="tch" value="&lt;b&gt;Training only (camera-pipeline DAgger)&lt;/b&gt;&lt;br&gt;Privileged teacher: IDM + SafeTeacher + curve guard 4.0&lt;br&gt;target speed 30(1 − c/3) km/h, following gap 10 + 15c m, true caution c&lt;br&gt;Teacher relabels the states the student visits; 4 rounds&lt;br&gt;Model B = network trained with oracle c · Model C = same network with ĉ at inference" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="882" width="500" height="96" as="geometry"/>
        </mxCell>

        <!-- edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="sim" target="wx"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="wx" target="cam"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="cam" target="det"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="cam" target="frm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="det" target="bev"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="frm" target="feat"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="feat" target="est"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="est" target="ema"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="bev" target="scal"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="BEV + scalars" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1" source="scal" target="pol"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="135" y="560"/><mxPoint x="135" y="602"/></Array></mxGeometry></mxCell>
        <mxCell id="e11" value="ĉ" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="ema" target="pol"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="582"/><mxPoint x="400" y="602"/></Array></mxGeometry></mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="pol" target="act"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="act" target="eng"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" value="labels (training only)" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#b85450;fontSize=9;" edge="1" parent="1" source="tch" target="pol"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="505" y="930"/><mxPoint x="505" y="643"/></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
